From 914f2c67fd50ed346c182aade1ac078fa3592b2b Mon Sep 17 00:00:00 2001
From: David Robillard <d@drobilla.net>
Date: Fri, 17 Jul 2020 15:38:38 +0200
Subject: [PATCH] Fix crash with optimized builds with GCC 10.1.0

---
 src/zix/btree.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/zix/btree.c b/src/zix/btree.c
index 3279f6c..f4108ed 100644
--- a/src/zix/btree.c
+++ b/src/zix/btree.c
@@ -863,7 +863,7 @@ zix_btree_iter_copy(const ZixBTreeIter* const i)
 bool
 zix_btree_iter_is_end(const ZixBTreeIter* const i)
 {
-	return !i || i->stack[0].node == NULL;
+	return !i || (i->level == 0 && i->stack[0].node == NULL);
 }
 
 bool
