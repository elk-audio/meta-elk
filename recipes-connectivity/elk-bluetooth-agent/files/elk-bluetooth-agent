#!/usr/bin/env python3
"""BlueZ pairing agent for Elk Audio OS — auto-accepts all pairing/auth requests."""

import dbus
import dbus.service
import dbus.mainloop.glib
from gi.repository import GLib
import subprocess
import sys
import time

AGENT_INTERFACE = "org.bluez.Agent1"
AGENT_PATH = "/org/bluez/elk/AutoPairAgent"
CAPABILITY = "NoInputNoOutput"


class AutoPairAgent(dbus.service.Object):
    """
    NoInputNoOutput agent: uses 'Just Works' SSP — no passkey confirmation.
    AuthorizeService is still called by BlueZ for profile access (e.g. A2DP),
    so we implement it and auto-accept.
    """

    @dbus.service.method(AGENT_INTERFACE, in_signature="", out_signature="")
    def Release(self):
        pass

    @dbus.service.method(AGENT_INTERFACE, in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        # Called when a remote device tries to use a BT profile (e.g. A2DP sink)
        print(f"Authorizing service {uuid} for {device}", flush=True)

    @dbus.service.method(AGENT_INTERFACE, in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        print(f"Accepting authorization for {device}", flush=True)

    @dbus.service.method(AGENT_INTERFACE, in_signature="o", out_signature="s")
    def RequestPinCode(self, device):
        return "0000"

    @dbus.service.method(AGENT_INTERFACE, in_signature="o", out_signature="u")
    def RequestPasskey(self, device):
        return dbus.UInt32(0)

    @dbus.service.method(AGENT_INTERFACE, in_signature="ouq", out_signature="")
    def DisplayPasskey(self, device, passkey, entered):
        pass

    @dbus.service.method(AGENT_INTERFACE, in_signature="os", out_signature="")
    def DisplayPinCode(self, device, pincode):
        pass

    @dbus.service.method(AGENT_INTERFACE, in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        # With NoInputNoOutput this should not be called, but handle it anyway
        print(f"Auto-confirming passkey {passkey} for {device}", flush=True)

    @dbus.service.method(AGENT_INTERFACE, in_signature="", out_signature="")
    def Cancel(self):
        pass


def wait_for_adapter(bus, timeout=30):
    """Poll DBus ObjectManager until a BlueZ Adapter1 is registered."""
    print(f"Waiting for Bluetooth adapter (up to {timeout}s)...", flush=True)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            om = dbus.Interface(
                bus.get_object("org.bluez", "/"),
                "org.freedesktop.DBus.ObjectManager",
            )
            for path, ifaces in om.GetManagedObjects().items():
                if "org.bluez.Adapter1" in ifaces:
                    print(f"Bluetooth adapter ready at {path}", flush=True)
                    return True
        except dbus.exceptions.DBusException:
            pass
        time.sleep(1)
    return False


def setup_adapter(bus, max_retries=5, retry_delay=2):
    if not wait_for_adapter(bus):
        print("Warning: no Bluetooth adapter found after timeout, skipping setup", flush=True)
        return
    for cmd in ["power on", "discoverable on", "pairable on"]:
        for attempt in range(1, max_retries + 1):
            r = subprocess.run(["bluetoothctl"] + cmd.split(), capture_output=True, text=True)
            output = r.stdout.strip()
            print(f"bluetoothctl {cmd}: {output}", flush=True)
            if r.returncode == 0 and "failed" not in output.lower() and "error" not in output.lower():
                break
            if attempt < max_retries:
                print(f"  retrying in {retry_delay}s ({attempt}/{max_retries})...", flush=True)
                time.sleep(retry_delay)
        else:
            print(f"Warning: '{cmd}' did not succeed after {max_retries} attempts", flush=True)


def main():
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()

    agent = AutoPairAgent(bus, AGENT_PATH)

    manager = dbus.Interface(
        bus.get_object("org.bluez", "/org/bluez"),
        "org.bluez.AgentManager1",
    )
    manager.RegisterAgent(AGENT_PATH, CAPABILITY)
    manager.RequestDefaultAgent(AGENT_PATH)
    print(f"Agent registered ({CAPABILITY}), waiting for connections...", flush=True)

    setup_adapter(bus)

    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        manager.UnregisterAgent(AGENT_PATH)
        sys.exit(0)


if __name__ == "__main__":
    main()
